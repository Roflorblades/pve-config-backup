# ===== Proxmox-Cluster =====

# Leerzeichengetrennte Liste der Proxmox-Nodes

PVE_NODES="pve01 pve02 pve03"

# SSH-Benutzer auf den Proxmox-Nodes

REMOTE_USER_PVE="root"

# Privater SSH-Schlüssel für den Zugriff auf die Proxmox-Nodes

SSH_KEY_PVE="/path/to/proxmox_id_rsa"

# ===== Lokale Backup-Ablage =====

# Temporäres Arbeitsverzeichnis für die Backups

BACKUP_BASE="/tmp/proxmox-backup"

# ===== Backup-VPS =====

# SSH-Benutzer auf dem Backup-Server

REMOTE_USER_VPS="backupuser"

# Hostname oder IP des Backup-Servers

REMOTE_HOST_VPS="backup.example.com"

# Privater SSH-Schlüssel für den Backup-Server

SSH_KEY_VPS="/path/to/vps_id_rsa"
